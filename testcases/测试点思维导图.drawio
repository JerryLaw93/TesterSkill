<mxfile host="app.diagrams.net"><diagram id="d1" name="测试点思维导图"><mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="[异常] 账号为空时点击登录，提示“请输入账号”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="40" width="220" height="34" as="geometry"/></mxCell><mxCell id="n2" value="[异常] 密码为空时点击登录，提示“请输入密码”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="82" width="220" height="34" as="geometry"/></mxCell><mxCell id="n3" value="[异常] 验证码为空时点击登录，提示“请输入验证码”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="124" width="220" height="34" as="geometry"/></mxCell><mxCell id="n4" value="基础校验" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="82.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n5" value="[边界] 账号输入框 maxlength=20，输入超过20位被截断" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="166" width="220" height="34" as="geometry"/></mxCell><mxCell id="n6" value="[边界] 密码输入框 maxlength=32，输入超过32位被截断" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="208" width="220" height="34" as="geometry"/></mxCell><mxCell id="n7" value="[边界] 验证码输入框 maxlength=4，仅能输入4位" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="250" width="220" height="34" as="geometry"/></mxCell><mxCell id="n8" value="输入边界" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="208.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n9" value="表单校验" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="145.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n10" value="[正向] 输入正确验证码（正确账号密码）登录成功" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="292" width="220" height="34" as="geometry"/></mxCell><mxCell id="n11" value="[异常] 输入错误验证码，提示“验证码错误”并自动刷新验证码、清空输入" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="334" width="220" height="34" as="geometry"/></mxCell><mxCell id="n12" value="[正向] 验证码大小写不敏感（小写输入可匹配大写验证码）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="376" width="220" height="34" as="geometry"/></mxCell><mxCell id="n13" value="[边界] 验证码输入含空格，trim 后参与比对" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="418" width="220" height="34" as="geometry"/></mxCell><mxCell id="n14" value="校验逻辑" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="355.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n15" value="[正向] 点击验证码图片刷新出新验证码" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="460" width="220" height="34" as="geometry"/></mxCell><mxCell id="n16" value="[UI] 验证码图片带噪点/干扰线，提示“看不清？点击图片刷新”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7C8E0;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="502" width="220" height="34" as="geometry"/></mxCell><mxCell id="n17" value="刷新交互" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="481.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n18" value="验证码功能" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="418.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n19" value="[正向] 使用默认账号 admin/123456 登录成功进入用户管理页" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="544" width="220" height="34" as="geometry"/></mxCell><mxCell id="n20" value="[正向] 登录成功后欢迎语显示“你好，{姓名}”，登录表单密码/验证码被清空" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="586" width="220" height="34" as="geometry"/></mxCell><mxCell id="n21" value="[UI] 登录成功无 error 提示，页面切换到 appView" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7C8E0;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="628" width="220" height="34" as="geometry"/></mxCell><mxCell id="n22" value="正向登录" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="586.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n23" value="[异常] 账号不存在，提示“账号或密码错误”并刷新验证码" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="670" width="220" height="34" as="geometry"/></mxCell><mxCell id="n24" value="[异常] 密码错误，提示“账号或密码错误”并刷新验证码" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="712" width="220" height="34" as="geometry"/></mxCell><mxCell id="n25" value="[异常] 账号与密码均错误，同样提示“账号或密码错误”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="754" width="220" height="34" as="geometry"/></mxCell><mxCell id="n26" value="异常登录" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="712.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n27" value="[权限] 已禁用账号（status=0）登录被拦截，提示“该账号已被禁用”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#6FA8DC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="796" width="220" height="34" as="geometry"/></mxCell><mxCell id="n28" value="[安全] 登录提示不区分“账号不存在”与“密码错误”，防止账号枚举" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#B39DDB;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="838" width="220" height="34" as="geometry"/></mxCell><mxCell id="n29" value="权限校验" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="817.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n30" value="登录流程" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="701.5" width="220" height="34" as="geometry"/></mxCell><mxCell id="n31" value="[UI] 登录页标题/副标题/默认账号提示（admin/123456）正常显示" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7C8E0;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="880" width="220" height="34" as="geometry"/></mxCell><mxCell id="n32" value="[UI] 提示消息红/绿色样式区分 error 与 success" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#F7C8E0;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="922" width="220" height="34" as="geometry"/></mxCell><mxCell id="n33" value="[兼容性] 不同浏览器（Chrome/Safari/Firefox）登录页布局正常" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#A2D9A2;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="964" width="220" height="34" as="geometry"/></mxCell><mxCell id="n34" value="UI检查" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="922.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n35" value="页面展示" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="922.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n36" value="登录模块" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#DAE8FC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="320" y="533.5" width="220" height="34" as="geometry"/></mxCell><mxCell id="n37" value="[正向] 登录后用户表格正常渲染（账号/姓名/角色/状态/创建时间/操作）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1006" width="220" height="34" as="geometry"/></mxCell><mxCell id="n38" value="[正向] 角色标签样式区分：管理员蓝色、普通用户绿色" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1048" width="220" height="34" as="geometry"/></mxCell><mxCell id="n39" value="[正向] 状态点区分启用（绿）/禁用（灰）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1090" width="220" height="34" as="geometry"/></mxCell><mxCell id="n40" value="[边界] 用户数据为空时表格显示“暂无数据”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1132" width="220" height="34" as="geometry"/></mxCell><mxCell id="n41" value="[边界] 姓名为空时显示“-”占位" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1174" width="220" height="34" as="geometry"/></mxCell><mxCell id="n42" value="列表渲染" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="1090.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n43" value="[安全] 账号/姓名含 <script> 等特殊字符时被转义，不执行XSS" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#B39DDB;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1216" width="220" height="34" as="geometry"/></mxCell><mxCell id="n44" value="安全显示" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="1216.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n45" value="用户列表" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="1153.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n46" value="[正向] 输入账号关键字，实时过滤列表" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1258" width="220" height="34" as="geometry"/></mxCell><mxCell id="n47" value="[正向] 输入姓名关键字，实时过滤列表" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1300" width="220" height="34" as="geometry"/></mxCell><mxCell id="n48" value="[边界] 关键字大小写不区分（大小写混合可匹配）" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1342" width="220" height="34" as="geometry"/></mxCell><mxCell id="n49" value="[异常] 输入无匹配关键字，列表显示“暂无数据”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1384" width="220" height="34" as="geometry"/></mxCell><mxCell id="n50" value="[边界] 关键字首尾带空格，trim 后仍能匹配" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1426" width="220" height="34" as="geometry"/></mxCell><mxCell id="n51" value="关键字搜索" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="1342.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n52" value="[正向] 角色筛选“全部角色”显示所有用户" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1468" width="220" height="34" as="geometry"/></mxCell><mxCell id="n53" value="[正向] 筛选“管理员”仅显示 admin 角色用户" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1510" width="220" height="34" as="geometry"/></mxCell><mxCell id="n54" value="[正向] 筛选“普通用户”仅显示 user 角色用户" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1552" width="220" height="34" as="geometry"/></mxCell><mxCell id="n55" value="[正向] 搜索关键字 + 角色筛选组合条件过滤" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1594" width="220" height="34" as="geometry"/></mxCell><mxCell id="n56" value="角色筛选" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="1531.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n57" value="搜索与筛选" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="1436.5" width="220" height="34" as="geometry"/></mxCell><mxCell id="n58" value="[异常] 账号含特殊字符或中文，提示“账号需为3-20位字母数字下划线”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1636" width="220" height="34" as="geometry"/></mxCell><mxCell id="n59" value="[边界] 账号合法边界：3位通过、2位被拒、20位通过、21位被拒" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1678" width="220" height="34" as="geometry"/></mxCell><mxCell id="n60" value="[异常] 密码长度<6位或>32位，提示“密码长度需为6-32位”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1720" width="220" height="34" as="geometry"/></mxCell><mxCell id="n61" value="[边界] 密码合法边界：6位通过、32位通过、5位/33位被拒" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1762" width="220" height="34" as="geometry"/></mxCell><mxCell id="n62" value="[异常] 已存在的账号重复新增，提示“该账号已存在”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FF6B6B;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1804" width="220" height="34" as="geometry"/></mxCell><mxCell id="n63" value="表单校验" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="1720.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n64" value="[正向] 填写合法信息新增普通用户成功，列表即时刷新" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1846" width="220" height="34" as="geometry"/></mxCell><mxCell id="n65" value="[正向] 新增管理员角色用户成功" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1888" width="220" height="34" as="geometry"/></mxCell><mxCell id="n66" value="[正向] 新增时状态选择“禁用”，保存后列表显示禁用" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1930" width="220" height="34" as="geometry"/></mxCell><mxCell id="n67" value="[正向] 新增成功后使用新账号可正常登录" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="1972" width="220" height="34" as="geometry"/></mxCell><mxCell id="n68" value="[边界] 姓名留空允许保存，列表显示“-”" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFB347;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="2014" width="220" height="34" as="geometry"/></mxCell><mxCell id="n69" value="新增流程" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="1930.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n70" value="新增用户" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="600" y="1825.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n71" value="[正向] 编辑姓名/角色/状态保存成功，列表数据更新" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="2056" width="220" height="34" as="geometry"/></mxCell><mxCell id="n72" value="[正向] 编辑弹窗回显用户原有数据" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="2098" width="220" height="34" as="geometry"/></mxCell><mxCell id="n73" value="[正向] 点击“取消”或遮罩层关闭弹窗，数据不变" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#9ACD32;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1160" y="2140" width="220" height="34" as="geometry"/></mxCell><mxCell id="n74" value="编辑流程" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#FFF2CC;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="880" y="2098.0" width="220" height="34" as="geometry"/></mxCell><mxCell id="n75" value="[权限] 编辑时账号输入框被禁用不可修改" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#6FA8DC;strokeC